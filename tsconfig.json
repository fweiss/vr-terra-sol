{
    "compileOnSave": true,
    "compilerOptions": {
      "target": "es5",              
      "module": "es2015", 
      "lib": [
        "es2015",
        "dom",
      ],
      "sourceMap": true,    
      "outDir": "./dist", 
      "types": [
        "babylonjs",
        "babylonjs-gui",
        "babylonjs-materials"
      ]                     
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
